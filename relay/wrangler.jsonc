{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "temp-canvas-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // Free plan requires SQLite-backed classes; the room never writes to storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Sites allowed to connect: production, then Vercel preview/deployment URLs (`*` = one label
    // part). Local dev overrides this with --var.
    "ALLOWED_ORIGINS": "https://temp-canvas.vercel.app,https://temp-canvas-*-bakiclaw-1743s-projects.vercel.app"
  }
}
