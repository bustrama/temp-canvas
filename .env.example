# Relay WebSocket base URL (the Cloudflare Worker), e.g. wss://temp-canvas-relay.<account>.workers.dev
# Leave empty in local dev: the app uses ws://<this host>:8787 (pnpm dev runs the relay there).
NEXT_PUBLIC_RELAY_URL=

# Optional: force the LAN address used in dev QR codes (auto-detected otherwise).
# DEV_LAN_IP=192.168.1.20
